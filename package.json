{
  "name": "Projeto_Barber_API",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "dotenv -e .env.development -- nest start",
    "start:dev": "dotenv -e .env.development -- nest start --watch",
    "test:int": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config ./jest.int.config.ts",
    "start:debug": "dotenv -e .env.development -- nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:worker": "dotenv -e .env.development -- node dist/worker",
    "start:worker:dev": "dotenv -e .env.development -- nest start --entryFile worker --watch",
    "start:worker:prod": "node dist/worker",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:cov": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:debug": "dotenv -e .env.test -- node --experimental-vm-modules --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "dotenv -e .env.test -- node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --config ./test/jest-e2e.json",
    "prisma:studio": "dotenv -e .env.development -- prisma studio",
    "prisma:generate": "dotenv -e .env.development -- prisma generate",
    "prisma:migrate:dev": "dotenv -e .env.development -- prisma migrate dev",
    "lint:fix": "pnpm lint --fix",
    "test:unit": "pnpm test",
    "prisma:migrate:deploy": "dotenv -e .env.development -- prisma migrate deploy",
    "prisma:migrate:test": "dotenv -e .env.test -- prisma migrate deploy",
    "db:up": "docker compose up -d --wait",
    "db:stop": "docker compose stop",
    "lint:check": "pnpm lint",
    "test:architecture": "node --test test/architecture/*.test.mjs",
    "check:architecture": "depcruise --config .dependency-cruiser.cjs --output-type err-long src"
  },
  "dependencies": {
    "@fastify/static": "^10.1.6",
    "@nestjs/common": "^11.2.7",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.58.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv-cli": "^9.0.0",
    "fastify": "^5.12.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "dependency-cruiser": "18.6.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "prisma": "^6.19.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24.9.0",
    "pnpm": ">=12.11.2 <13"
  }
}
