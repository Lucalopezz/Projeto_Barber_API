generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String        @id @default(uuid())
  name                 String
  email                String        @unique
  password             String
  role                 Role
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  ownedBarberShops     BarberShop[]  @relation("Owner")
  barberShopId         String?
  barberShop           BarberShop?   @relation("Barbers", fields: [barberShopId], references: [id], onDelete: SetNull)
  appointmentsAsClient Appointment[] @relation("ClientAppointments")
  appointmentsAsBarber Appointment[] @relation("BarberAppointments")
  schedules            BarberSchedule[]
  timeOffs             BarberTimeOff[]
  authSessions         AuthSession[]
  barberShopInvitations BarberShopInvitation[]
  notifications        Notification[]
}

model BarberShop {
  id           String        @id @default(uuid())
  name         String
  address      String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  ownerId      String
  timezone     String        @default("America/Sao_Paulo")
  owner        User          @relation("Owner", fields: [ownerId], references: [id], onDelete: Restrict)
  services     Service[]
  barbers      User[]        @relation("Barbers")
  appointments Appointment[]
  invitations  BarberShopInvitation[]
}

model BarberShopInvitation {
  id           String     @id @default(uuid())
  barberShopId String
  barberId     String
  createdAt    DateTime   @default(now())
  barberShop   BarberShop @relation(fields: [barberShopId], references: [id], onDelete: Cascade)
  barber       User       @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberShopId, barberId])
  @@index([barberId])
}

model Service {
  id           String        @id @default(uuid())
  name         String
  price        Decimal       @db.Decimal(10, 2)
  duration     Int
  description  String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  barberShopId String
  barberShop   BarberShop    @relation(fields: [barberShopId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id           String            @id @default(uuid())
  date         DateTime          @db.Timestamptz(3)
  endDate      DateTime          @db.Timestamptz(3)
  status       AppointmentStatus @default(scheduled)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  version      Int               @default(0)
  clientId     String
  client       User              @relation("ClientAppointments", fields: [clientId], references: [id], onDelete: Restrict)
  barberId     String
  barber       User              @relation("BarberAppointments", fields: [barberId], references: [id], onDelete: Restrict)
  barberShopId String
  barberShop   BarberShop        @relation(fields: [barberShopId], references: [id], onDelete: Restrict)
  serviceId    String
  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  notifications Notification[]
  notificationOutbox NotificationOutbox[]

  @@index([clientId])
  @@index([barberId])
  @@index([barberShopId])
  @@index([serviceId])
  @@index([barberId, date, endDate])
  @@index([status, date, id])
}

model BarberSchedule {
  id         String @id @default(uuid())
  barberId   String
  dayOfWeek  Int
  startMinute Int
  endMinute  Int
  barber     User   @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@unique([barberId, dayOfWeek, startMinute, endMinute])
  @@index([barberId, dayOfWeek])
}

model BarberTimeOff {
  id        String   @id @default(uuid())
  barberId  String
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?
  barber    User     @relation(fields: [barberId], references: [id], onDelete: Cascade)

  @@index([barberId, startsAt, endsAt])
}

enum Role {
  owner
  barber
  client
}

enum AppointmentStatus {
  scheduled
  completed
  cancelled
}

model AuthSession {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  tokens AuthRefreshToken[]
  @@index([userId])
}

model AuthRefreshToken {
  id String @id @default(uuid())
  sessionId String
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  hash String
  consumedAt DateTime? @db.Timestamptz(3)
  @@unique([sessionId, hash])
}

enum NotificationType {
  appointment_created
  appointment_updated
  appointment_cancelled
  appointment_reminder
}

model Notification {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointmentId  String
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  eventKey       String
  type           NotificationType
  serviceName    String
  barberShopName String
  startsAt       DateTime         @db.Timestamptz(3)
  timezone       String
  previousStartsAt DateTime?       @db.Timestamptz(3)
  previousServiceName String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  readAt         DateTime?        @db.Timestamptz(3)

  @@unique([eventKey, userId])
  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@index([appointmentId])
}

model NotificationOutbox {
  id             String           @id @default(uuid())
  eventKey       String           @unique
  type           NotificationType
  appointmentId  String
  appointmentVersion Int?
  appointment    Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  recipientIds   String[]
  serviceName    String
  barberShopName String
  startsAt       DateTime         @db.Timestamptz(3)
  timezone       String
  previousStartsAt DateTime?       @db.Timestamptz(3)
  previousServiceName String?
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  processedAt    DateTime?        @db.Timestamptz(3)

  @@index([processedAt, id])
  @@index([appointmentId])
}
