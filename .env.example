# Desenvolvimento local. Copie para .env.development.
APP_PORT=3001
NODE_ENV=development
DATABASE_URL="postgresql://postgres:docker@localhost:5450/barber_api?schema=public"
# Apenas desenvolvimento; substitua por um valor aleatório no seu .env local.
JWT_SECRET=local-development-only-change-me
JWT_EXPIRES_IN=900
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AUTH_SESSION_TTL_SECONDS=604800
AUTH_COOKIE_SECURE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_DB=0
NOTIFICATIONS_QUEUE_PREFIX=barber-notifications
# Opcional para Redis autenticado; nunca commitar senha real.
REDIS_PASSWORD=
